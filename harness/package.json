{
  "name": "benchwarmer-harness",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Pi Durable harness for Benchwarmer's model-driven conversation analysis workflows",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "propose-bundles": "node --import tsx src/cli.ts propose-bundles",
    "list-models": "node --import tsx src/cli.ts list-models"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "typebox": "1.3.27",
    "@earendil-works/chord": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
